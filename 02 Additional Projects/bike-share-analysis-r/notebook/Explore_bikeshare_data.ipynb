<div class="cell border-box-sizing code_cell rendered">
<div class="input">
<div class="prompt input_prompt">In&nbsp;[11]:</div>
<div class="inner_cell">
    <div class="input_area">
<div class=" highlight hl-r"><pre><span></span><span class="c1"># Function to find the most common start stations</span>
<span class="n">get_top_stations</span> <span class="o">&lt;-</span> <span class="nf">function</span><span class="p">(</span><span class="n">df</span><span class="p">,</span> <span class="n">city_name</span><span class="p">,</span> <span class="n">n</span> <span class="o">=</span> <span class="m">10</span><span class="p">)</span> <span class="p">{</span>
    <span class="n">station_counts</span> <span class="o">&lt;-</span> <span class="nf">as.data.frame</span><span class="p">(</span>
        <span class="nf">sort</span><span class="p">(</span><span class="nf">table</span><span class="p">(</span><span class="n">df</span><span class="o">$</span><span class="n">Start.Station</span><span class="p">),</span> <span class="n">decreasing</span> <span class="o">=</span> <span class="kc">TRUE</span><span class="p">)</span>
    <span class="p">)</span>

    <span class="nf">names</span><span class="p">(</span><span class="n">station_counts</span><span class="p">)</span> <span class="o">&lt;-</span> <span class="nf">c</span><span class="p">(</span><span class="s">&quot;Station&quot;</span><span class="p">,</span> <span class="s">&quot;Rides&quot;</span><span class="p">)</span>
    <span class="n">station_counts</span><span class="o">$</span><span class="n">City</span> <span class="o">&lt;-</span> <span class="n">city_name</span>

    <span class="nf">head</span><span class="p">(</span><span class="n">station_counts</span><span class="p">,</span> <span class="n">n</span><span class="p">)</span>
<span class="p">}</span>

<span class="c1"># Find the top 10 start stations in each city</span>
<span class="n">top_chicago</span> <span class="o">&lt;-</span> <span class="nf">get_top_stations</span><span class="p">(</span><span class="n">chi</span><span class="p">,</span> <span class="s">&quot;Chicago&quot;</span><span class="p">)</span>
<span class="n">top_new_york</span> <span class="o">&lt;-</span> <span class="nf">get_top_stations</span><span class="p">(</span><span class="n">ny</span><span class="p">,</span> <span class="s">&quot;New York City&quot;</span><span class="p">)</span>
<span class="n">top_washington</span> <span class="o">&lt;-</span> <span class="nf">get_top_stations</span><span class="p">(</span><span class="n">wash</span><span class="p">,</span> <span class="s">&quot;Washington&quot;</span><span class="p">)</span>

<span class="n">top_stations</span> <span class="o">&lt;-</span> <span class="nf">rbind</span><span class="p">(</span>
    <span class="n">top_chicago</span><span class="p">,</span>
    <span class="n">top_new_york</span><span class="p">,</span>
    <span class="n">top_washington</span>
<span class="p">)</span>

<span class="n">top_stations</span>
</pre></div>

